{
  "name": "a11y-fixer",
  "displayName": "A11y Fixer",
  "description": "Local accessibility check and confirmed fixes for Vue 3 + Vite and Nuxt.",
  "version": "0.1.0",
  "publisher": "a11y-fixer",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters"],
  "activationEvents": [
    "onView:a11yFixer.main",
    "onCommand:a11yFixer.pickScope",
    "onCommand:a11yFixer.auditTarget",
    "onCommand:a11yFixer.auditProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "a11yFixer",
          "title": "A11y Fixer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "a11yFixer": [
        {
          "type": "webview",
          "id": "a11yFixer.main",
          "name": "A11y Fixer"
        }
      ]
    },
    "commands": [
      {
        "command": "a11yFixer.pickScope",
        "title": "%a11yFixer.pickScope.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "a11yFixer.audit",
        "title": "%a11yFixer.audit.title%",
        "icon": "$(play)"
      },
      {
        "command": "a11yFixer.auditTarget",
        "title": "%a11yFixer.auditTarget.title%"
      },
      {
        "command": "a11yFixer.auditProject",
        "title": "%a11yFixer.auditProject.title%"
      }
    ],
    "configuration": {
      "title": "A11y Fixer",
      "properties": {
        "a11yFixer.excludeDirectories": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["node_modules", "dist", "build", ".git", ".nuxt", ".output"],
          "description": "%a11yFixer.excludeDirectories.description%"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "a11yFixer.pickScope",
          "when": "view == a11yFixer.main",
          "group": "navigation@1"
        },
        {
          "command": "a11yFixer.audit",
          "when": "view == a11yFixer.main",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "a11yFixer.auditTarget",
          "when": "resourceScheme == file",
          "group": "a11yFixer@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/unit/*.test.js",
    "test:dynamic": "npm run compile && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=180000 out-test/test/integration/dynamic-errors.test.js",
    "test:vite": "npm run compile && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=300000 out-test/test/integration/vite-audit.test.js",
    "test:nuxt": "npm run compile && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=300000 out-test/test/integration/nuxt-audit.test.js",
    "test:libraries": "npm run compile && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=300000 out-test/test/integration/library-audit.test.js",
    "test:editor": "npm run compile && tsc -p tsconfig.test.json && node out-test/test/editor/run.js",
    "check": "npm run compile && npm test && npm run test:dynamic && npm run test:vite",
    "experiment:nuxt": "npm run compile && node experiments/nuxt-source-id/run.mjs"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/vscode": "1.85.0",
    "typescript": "5.9.3"
  }
}
